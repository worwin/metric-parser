{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metric-parser.local/schemas/metric_warning.schema.json",
  "title": "Metric Warning Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "warning_id": { "type": "string" },
    "metric_record_id": { "type": ["string", "null"] },
    "cik": { "type": "string" },
    "ticker": { "type": "string" },
    "filing_period": { "type": "string", "format": "date" },
    "fiscal_year": { "type": "integer" },
    "fiscal_quarter": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
    "period_type": { "type": "string", "enum": ["annual", "quarterly", "ttm"] },
    "metric_code": { "type": ["string", "null"] },
    "warning_code": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "error"] },
    "warning_source": { "type": "string", "enum": ["parser", "mapping", "quarterization", "formula", "applicability"] },
    "message": { "type": "string" },
    "source_accession": { "type": ["string", "null"] },
    "upstream_warning_code": { "type": ["string", "null"] },
    "created_at": { "type": "string" }
  },
  "required": [
    "warning_id",
    "metric_record_id",
    "cik",
    "ticker",
    "filing_period",
    "fiscal_year",
    "fiscal_quarter",
    "period_type",
    "metric_code",
    "warning_code",
    "severity",
    "warning_source",
    "message",
    "source_accession",
    "upstream_warning_code",
    "created_at"
  ]
}

